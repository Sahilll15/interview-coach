# OPENAI_REALTIME_MODEL=gpt-realtime-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_VOICE=marin
# SESSION_SECONDS=270
# RATE_LIMIT_SESSIONS=3
# RATE_LIMIT_TURNS=40
# RATE_LIMIT_REPORTS=5
# RATE_LIMIT_WINDOW_MS=3600000
# DAILY_SESSION_BUDGET=30
