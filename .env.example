OPENAI_API_KEY=
# Text interviewer and reports go to Groq when this is set, with OpenAI as the fallback. Voice stays on OpenAI.
GROQ_API_KEY=
# More Groq keys, comma or newline separated. Tried in order after GROQ_API_KEY before falling back to OpenAI.
GROQ_API_KEYS=
